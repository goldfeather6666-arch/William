# ---------------------------------------------------------------------------
# MedCoach AI — environment configuration
# Copy to .env.local for local development. Never commit real secrets.
# ---------------------------------------------------------------------------

# Public site URL (used for auth email redirects and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (required for accounts, persistence, storage) -----------------
NEXT_PUBLIC_SUPABASE_URL=
# Prefer the modern "publishable" key; the legacy "anon" key is also accepted.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by background document processing and admin operations.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers (optional; users may also bring their own keys) -----------
# Any subset works. Providers are tried in order with fallbacks.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_MODEL=gemini-2.0-flash

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# Any OpenAI-compatible endpoint (self-hosted, Azure proxy, etc.)
CUSTOM_AI_API_KEY=
CUSTOM_AI_BASE_URL=
CUSTOM_AI_MODEL=

# Optional model used for embeddings. Falls back to deterministic local
# embeddings (labeled "local-hash") when no provider embedding model is set.
AI_EMBEDDING_PROVIDER=openai
AI_EMBEDDING_MODEL=text-embedding-3-small

# AES-256-GCM key (base64, 32 bytes) used to encrypt user-supplied API keys.
# Generate with: openssl rand -base64 32
AI_KEY_ENCRYPTION_SECRET=

# --- Document pipeline ------------------------------------------------------
# Optional OCR microservice. POST { image: base64 } -> { text: string }
OCR_ENDPOINT_URL=
OCR_ENDPOINT_TOKEN=

# --- Billing (modular; "manual" enables admin-granted credits/plans) --------
# disabled | manual | stripe (Stripe adapter interface only, see docs)
PAYMENTS_PROVIDER=manual
